<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Resources\icon128.ico</ApplicationIcon>
        <Platforms>x64</Platforms>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <Company>LukaRepos</Company>
        <Product>VoiceSynth</Product>
        <AssemblyName>VoiceSynth</AssemblyName>
        <PackageId>VoiceSynth</PackageId>
        <Version>0.9.9</Version>
        <Title>VoiceSynth</Title>
        <Authors>LukaRepos</Authors>
        <Description>No microphone, it doesn't matter.</Description>
        <PackageIcon>Resources\icon128.png</PackageIcon>
        <RepositoryUrl>https://github.com/LPLP-ghacc/Voice-Synth</RepositoryUrl>
        <AssemblyVersion>0.9.9</AssemblyVersion>
        <NeutralLanguage>en-US</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ConseqConcatenation" Version="1.0.5" />
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="System.Speech" Version="11.0.0-preview.1.26104.118" />
    </ItemGroup>

    <ItemGroup>
        <!-- Иконка приложения -->
        <None Remove="Resources\micIco.ico" />

        <!-- Файл настроек -->
        <Content Include="settings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>

        <!-- Piper TTS: все файлы рекурсивно, структура папок сохраняется -->
        <Content Include="piper\**\*" Condition="Exists('piper')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>piper\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Content>
        <None Remove="Resources\icon128.png" />
        <Content Include="Resources\icon128.png">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <!-- PackageIcon требует None + Pack=true, отдельно от Resource -->
        <None Include="Resources\icon128.png" Pack="true" PackagePath="Resources\"/>
        <None Remove="Resources\icon128.ico" />
        <Content Include="Resources\icon128.ico">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Page Remove="Resources\Strings.en.xaml" />
      <Resource Include="Resources\Strings.en.xaml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Resource>
      <None Remove="Resources\icon64.png" />
      <Content Include="Resources\icon64.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Page Update="CustomControls\SettingsWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="CustomControls\NumButton.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="CustomControls\SnippetCreationWind.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="CustomControls\TopPanel.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

</Project>
